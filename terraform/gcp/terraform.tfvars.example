# Copy to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git

project_id          = "your-gcp-project-id"
region              = "europe-west1"      # Belgium - lowest latency from Ireland
zone                = "europe-west1-b"
machine_type        = "e2-medium"         # 2 vCPU / 4 GB - sufficient for prototype
admin_username      = "vcsadmin"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
management_cidr     = "YOUR.IP.HERE/32"   # restrict SSH to your IP
