{
  "title": "Redis — Cache & Streams",
  "uid": "redis-deep-dive",
  "description": "Redis memory, client connections, hit rate, keyspace, streams, and replication",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "graphTooltip": 1,
  "tags": ["redis", "cache", "streams", "data-layer"],
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "row", "title": "OVERVIEW",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 2, "type": "stat", "title": "Uptime",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_uptime_in_seconds{job=\"redis\"}", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "fixedColor": "blue", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 3, "type": "stat", "title": "Connected Clients",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_connected_clients{job=\"redis\"}", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 100 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 4, "type": "stat", "title": "Memory Used",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_memory_used_bytes{job=\"redis\"}", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "fixedColor": "purple", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 5, "type": "stat", "title": "Cache Hit Rate",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) / (rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) + rate(redis_keyspace_misses_total{job=\"redis\"}[5m]))", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "green", "value": 90 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 6, "type": "stat", "title": "Total Keys",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(redis_db_keys{job=\"redis\"})", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "blue", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 7, "type": "stat", "title": "Commands/sec",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(redis_commands_processed_total{job=\"redis\"}[1m])", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "fixedColor": "orange", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 8, "type": "row", "title": "MEMORY",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 9, "type": "timeseries", "title": "Memory Used vs Peak vs Limit",
      "gridPos": { "x": 0, "y": 6, "w": 16, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_memory_used_bytes{job=\"redis\"}", "legendFormat": "Used", "refId": "A" },
        { "expr": "redis_memory_used_peak_bytes{job=\"redis\"}", "legendFormat": "Peak", "refId": "B" },
        { "expr": "redis_memory_max_bytes{job=\"redis\"}", "legendFormat": "Max (limit)", "refId": "C" }
      ],
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Max (limit)" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Peak" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [5, 5], "fill": "dash" } }] },
          { "matcher": { "id": "byName", "options": "Used" }, "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }, { "id": "custom.fillOpacity", "value": 20 }] }
        ]
      }
    },
    {
      "id": 10, "type": "gauge", "title": "Memory Fragmentation Ratio",
      "description": "RSS/Used — >1.5 means fragmentation; <1 means memory swapped out (bad)",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_mem_fragmentation_ratio{job=\"redis\"}", "legendFormat": "fragmentation", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 0.8 }, { "color": "green", "value": 1.5 }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 2.5 }] }, "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 11, "type": "row", "title": "CLIENTS & CONNECTIONS",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 12, "type": "timeseries", "title": "Client Connections",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_connected_clients{job=\"redis\"}", "legendFormat": "Connected", "refId": "A" },
        { "expr": "redis_blocked_clients{job=\"redis\"}", "legendFormat": "Blocked", "refId": "B" },
        { "expr": "redis_tracking_clients{job=\"redis\"}", "legendFormat": "Tracking", "refId": "C" }
      ],
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Blocked" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Connected" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 13, "type": "timeseries", "title": "Rejected & Closed Connections",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(redis_rejected_connections_total{job=\"redis\"}[1m])", "legendFormat": "Rejected/s", "refId": "A" },
        { "expr": "rate(redis_connections_received_total{job=\"redis\"}[1m])", "legendFormat": "New Connections/s", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }, "overrides": [{ "matcher": { "id": "byName", "options": "Rejected/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }, { "id": "custom.fillOpacity", "value": 15 }] }] }
    },
    {
      "id": 14, "type": "row", "title": "OPERATIONS & THROUGHPUT",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 15, "type": "timeseries", "title": "Commands Processed / sec",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rate(redis_commands_processed_total{job=\"redis\"}[1m])", "legendFormat": "ops/s", "refId": "A" }],
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" }, "color": { "fixedColor": "orange", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 16, "type": "timeseries", "title": "Keyspace Hits vs Misses",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(redis_keyspace_hits_total{job=\"redis\"}[1m])", "legendFormat": "Hits/s", "refId": "A" },
        { "expr": "rate(redis_keyspace_misses_total{job=\"redis\"}[1m])", "legendFormat": "Misses/s", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Hits/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Misses/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 17, "type": "timeseries", "title": "Network I/O",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(redis_net_input_bytes_total{job=\"redis\"}[1m])", "legendFormat": "Input (RX)", "refId": "A" },
        { "expr": "rate(redis_net_output_bytes_total{job=\"redis\"}[1m])", "legendFormat": "Output (TX)", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] }
    },
    {
      "id": 18, "type": "timeseries", "title": "Slow Log Length",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_slowlog_length{job=\"redis\"}", "legendFormat": "slow log entries", "refId": "A" }],
      "options": { "legend": { "calcs": ["max", "last"], "displayMode": "table", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "fixedColor": "red", "mode": "fixed" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] } }, "overrides": [] }
    },
    {
      "id": 19, "type": "row", "title": "KEYSPACE",
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 20, "type": "timeseries", "title": "Keys by Database",
      "gridPos": { "x": 0, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_db_keys{job=\"redis\"}", "legendFormat": "{{db}} total", "refId": "A" },
        { "expr": "redis_db_keys_expiring{job=\"redis\"}", "legendFormat": "{{db}} expiring", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "id": 21, "type": "timeseries", "title": "Key Expirations & Evictions",
      "gridPos": { "x": 12, "y": 40, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(redis_expired_keys_total{job=\"redis\"}[1m])", "legendFormat": "Expired keys/s", "refId": "A" },
        { "expr": "rate(redis_evicted_keys_total{job=\"redis\"}[1m])", "legendFormat": "Evicted keys/s", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Evicted keys/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 22, "type": "row", "title": "STREAMS",
      "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 23, "type": "timeseries", "title": "Stream Length",
      "description": "Number of entries in each Redis Stream (requires streams to be configured)",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_stream_length{job=\"redis\"}", "legendFormat": "{{stream}}", "refId": "A" }],
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "id": 24, "type": "timeseries", "title": "Stream Pending Entries",
      "description": "Messages delivered to consumers but not yet acknowledged (consumer group lag)",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_stream_pending_entries_length{job=\"redis\"}", "legendFormat": "{{stream}}/{{group}}", "refId": "A" }],
      "options": { "legend": { "calcs": ["last", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 15 }, "color": { "mode": "palette-classic" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] } }, "overrides": [] }
    },
    {
      "id": 25, "type": "stat", "title": "Stream Consumer Groups",
      "gridPos": { "x": 0, "y": 57, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(redis_stream_groups{job=\"redis\"})", "legendFormat": "consumer groups", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "fixedColor": "blue", "mode": "fixed" } }, "overrides": [] }
    },
    {
      "id": 26, "type": "row", "title": "PERSISTENCE & REPLICATION",
      "gridPos": { "x": 0, "y": 61, "w": 24, "h": 1 }, "collapsed": false
    },
    {
      "id": 27, "type": "timeseries", "title": "RDB Save Duration",
      "gridPos": { "x": 0, "y": 62, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_rdb_last_save_timestamp_seconds{job=\"redis\"}", "legendFormat": "Last RDB save", "refId": "A" },
        { "expr": "redis_rdb_current_bgsave_in_progress{job=\"redis\"}", "legendFormat": "BGSAVE in progress", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }, "overrides": [] }
    },
    {
      "id": 28, "type": "timeseries", "title": "Replication",
      "gridPos": { "x": 12, "y": 62, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "redis_connected_slaves{job=\"redis\"}", "legendFormat": "Connected Replicas", "refId": "A" },
        { "expr": "redis_master_repl_offset{job=\"redis\"}", "legendFormat": "Master Replication Offset", "refId": "B" }
      ],
      "options": { "legend": { "calcs": ["last"], "displayMode": "table", "placement": "bottom" } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }, "overrides": [] }
    }
  ]
}
