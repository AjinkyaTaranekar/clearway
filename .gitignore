# Terraform
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/terraform.tfvars
**/.terraform.lock.hcl

# Go build artifacts
**/bin/
**/dist/
**/*.test
**/coverage.out
**/coverage.html

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.next/

# nginx built artifacts (populated by CI)
nginx/html/*
!nginx/html/.gitkeep

# Environment and secrets
*.env
.env.*
**/.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# Local AI / editor
.claude/

# IAM RSA keys (generate per environment; never commit private keys)
iam-service/keys/*.pem
